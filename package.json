{
	"name": "qdrant-sync",
	"version": "0.0.2",
	"bin": {
		"qdrant-sync": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"build": "npm run typecheck && npm run lint && tsup src/cli.ts src/index.ts --format esm --dts --outDir dist --clean"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"require": "./dist/index.mjs",
			"import": "./dist/index.mjs"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.2",
		"globals": "^17.11.0",
		"tsup": "^8.0.0",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@qdrant/js-client-rest": "1.17.0",
		"@typescript-eslint/parser": "^8.67.0",
		"commander": "^15.0.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.8.1",
		"jiti": "^2.7.0",
		"typescript-eslint": "^8.67.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	}
}
